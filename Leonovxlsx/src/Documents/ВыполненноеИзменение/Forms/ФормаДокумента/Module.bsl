
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.Ссылка.Пустая() Тогда
		ЗаполнитьТаблицуКартинкиСтрок();
		КартинкиСтрок[Объект.НомерКартинкиСтроки].ФлагВыбора = Истина;
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьТаблицуКартинкиСтрок()
	
	Если ЗначениеЗаполнено(КартинкиСтрок) Тогда
		Для ном = 0 По 10 Цикл             
			КартинкиСтрок[ном].ФлагВыбора = Ложь;
		КонецЦикла;
		Возврат;
	КонецЕсли; 
	
	Для ном = 0 По 10 Цикл             
		стр_ = КартинкиСтрок.Добавить();
		стр_.НомерКартинки = ном;
	КонецЦикла;

КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если ЗначениеЗаполнено(Объект.Задача) Тогда 
		УстановитьПоляЗадачи();
	КонецЕсли;

КонецПроцедуры   

&НаКлиенте
Процедура УстановитьПоляЗадачи()  
	
	РеквизитыЗадачи = ПолучитьРеквизитыЗадачи(Объект.Задача);
	КодЗадачи = РеквизитыЗадачи.Код;
	СсылкаНаЗадачу = РеквизитыЗадачи.СсылкаНаЗадачу;
	ПрочитатьСтатусЗадачи();
	КомментарийДляРеквизитов = "#" + КодЗадачи + " " + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy") + " " + Объект.Разработчик;  
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыЗадачи(Задача)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	k_card.Код КАК Код,
	|	k_card.СсылкаНаЗадачу КАК СсылкаНаЗадачу
	|ИЗ
	|	Справочник.k_card КАК k_card
	|ГДЕ
	|	k_card.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Задача);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	РезультатЗапроса.Следующий();   
	Возврат ОбщийМодульКлиентСервер.СтруктураИзВыборкиЗапроса(РезультатЗапроса);
	
КонецФункции  

&НаКлиенте
Процедура ПрочитатьСтатусЗадачи()

	ответ_ = ОбщийМодульКлиентСервер.ЗадачаПолучитьИнфо(КодЗадачи); 
	Если НЕ ответ_.Свойство("column") ИЛИ НЕ ответ_.Свойство("type") Тогда
		Возврат;
	КонецЕсли;
	СтатусСтрокой = СтрШаблон("%1 (%2)", ответ_.column.title, ответ_.type.name);
	
КонецПроцедуры


&НаКлиенте
Процедура ЗадачаПриИзменении(Элемент) 
	
	УстановитьПоляЗадачи();
	ПрочитатьСтатусЗадачи();
	
КонецПроцедуры


&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект) 
	
	ЗаметкиФорматированныйДокумент = ТекущийОбъект.ЗаметкиРазработчика.Получить(); 
	ЗаполнитьТаблицуКартинкиСтрок();
	КартинкиСтрок[ТекущийОбъект.НомерКартинкиСтроки].ФлагВыбора = Истина;

КонецПроцедуры


&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ТекущийОбъект.ЗаметкиРазработчика = Новый ХранилищеЗначения(ЗаметкиФорматированныйДокумент);
КонецПроцедуры

&НаКлиенте
Процедура КартинкиСтрокПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования) 
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Если Элемент.ТекущиеДанные.ФлагВыбора = Ложь Тогда
		Объект.НомерКартинкиСтроки = 0;  
		КартинкиСтрок[0].ФлагВыбора = Истина;
		Возврат;
	КонецЕсли;
	
	Для ном = 0 По 10 Цикл
		
		Если Элемент.ТекущиеДанные.НомерКартинки = ном Тогда
			Продолжить;
		КонецЕсли;  
		
		КартинкиСтрок[ном].ФлагВыбора = Ложь;
		
	КонецЦикла;    
	
	Объект.НомерКартинкиСтроки = Элемент.ТекущиеДанные.НомерКартинки;  
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадачаСсылкаНажатие(Элемент)
	ЗапуститьПриложение(СсылкаНаЗадачу);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьИзКомментария(Команда) 
	
	Оповещение = Новый ОписаниеОповещения("ОбработатьДобавление", ЭтаФорма);
	ОткрытьФорму("Документ.ВыполненноеИзменение.Форма.ФормаДобавления",, ЭтаФорма,,,,
		Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);     
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьДобавление(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого стр_ Из Результат Цикл
		
		стр_ТаблицаИзменений = Объект.ТаблицаИзменений.Добавить();
		стр_ТаблицаИзменений.ВидИзменения = ПредопределенноеЗначение("Перечисление.ВидыИзменений.изменен");
		стр_ТаблицаИзменений.ОбъектИзменений = стр_;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВидНаДобавлен(Команда)
	
	Если НЕ ЗначениеЗаполнено(Элементы.ТаблицаИзменений.ВыделенныеСтроки) Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого стр_ Из Элементы.ТаблицаИзменений.ВыделенныеСтроки Цикл
		Объект.ТаблицаИзменений.НайтиПоИдентификатору(стр_).ВидИзменения =
			ПредопределенноеЗначение("Перечисление.ВидыИзменений.добавлен");
	КонецЦикла; 
		
	Модифицированность = Истина;	
	
КонецПроцедуры

&НаКлиенте
Процедура ТекстДляСообщений(Команда)
	
	стр_шаблон = "задача [%1](%2)";
	ТекстОтображения = СтрШаблон(стр_шаблон, Строка(Объект.Задача), СсылкаНаЗадачу);
	//Оповещение = Новый ОписаниеОповещения("ПослеВводаСтроки", ЭтотОбъект);
	//ПоказатьВводСтроки(Оповещение, ТекстОтображения, "Задача"); 
	
	ЗаметкиФорматированныйДокумент.Вставить(ЗаметкиФорматированныйДокумент.ПолучитьЗакладкуНачала(),, ТипЭлементаФорматированногоДокумента.ПереводСтроки);  
	Фрагмент = ЗаметкиФорматированныйДокумент.Вставить(ЗаметкиФорматированныйДокумент.ПолучитьЗакладкуНачала(),
		Строка(Объект.Задача), ТипЭлементаФорматированногоДокумента.Текст);
	Фрагмент.НавигационнаяСсылка = СсылкаНаЗадачу;
	
КонецПроцедуры

Процедура ПослеВводаСтроки(Строка, Параметры) Экспорт

КонецПроцедуры;





























