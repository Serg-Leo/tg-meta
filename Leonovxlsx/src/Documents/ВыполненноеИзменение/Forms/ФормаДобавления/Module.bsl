
&НаКлиенте
Процедура ДобавитьВСписок(Команда)

	СоздатьНеобходимыеЭлементы();
	
	массив = Новый Массив;
	Для каждого стр_ Из список.НайтиСтроки(Новый Структура("ВыбФлаг", Истина)) Цикл
		массив.Добавить(стр_.Справочник);
	КонецЦикла;     
	
	Закрыть(массив);

КонецПроцедуры  

&НаСервере
Процедура СоздатьНеобходимыеЭлементы()  
		
	Для каждого стр_ Из список.НайтиСтроки(Новый Структура("ВыбФлаг,Справочник", Истина, Справочники.ОбъектыИзменений.ПустаяСсылка())) Цикл
		СоздатьЭлементСписка(стр_);
	КонецЦикла;
	
КонецПроцедуры  

&НаСервере
Процедура СоздатьЭлементСписка(стр_)
	
	спр_ = Справочники.ОбъектыИзменений.СоздатьЭлемент();
	спр_.Владелец = Конфигурация;
	спр_.Наименование = стр_.Название;
	спр_.ПолноеНаименование = стр_.Название;
	спр_.Записать();   
	
	стр_.Справочник = спр_.Ссылка;
	
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)             
	
	Конфигурация = ВладелецФормы.Объект.Конфигурация; 
	
	соотв = Новый Соответствие;
	Для каждого стр_ТИ Из ВладелецФормы.Объект.ТаблицаИзменений Цикл
		соотв.Вставить(стр_ТИ.ОбъектИзменений, Истина);
	КонецЦикла; 
	СущОбъекты = Новый ФиксированноеСоответствие(соотв);
	
	мСтроки = СтрРазделить(ВладелецФормы.Объект.Комментарий, Символы.ПС, Ложь);   
	
	список.Очистить();
	Для каждого стр_ Из мСтроки Цикл
		
		Если СтрНачинаетсяС(стр_, "Объект ") Тогда
			ДобавитьЭлементВСписок(стр_);
		КонецЕсли;
		
	КонецЦикла; 
	
	ОбработатьСписокНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЭлементВСписок(стр_) 
	
	Если СтрЧислоВхождений(стр_, "захвачен для редактирования другим пользователем") > 0 Тогда
		Возврат;
	КонецЕсли;  
	
	стр_ = СтрЗаменить(стр_, ": ", "§"); 
	массив = СтрРазделить(стр_, "§", Ложь);  
	Если массив.Количество() = 1 Тогда
		Возврат;
	КонецЕсли;
	
	стр_список = список.Добавить(); 
	стр_список.Название = массив[1];   
	
	мОбъектыСМодулями = Новый Массив; 
	мОбъектыСМодулями.Добавить("ПланОбмена");
	мОбъектыСМодулями.Добавить("WebСервис");
	мОбъектыСМодулями.Добавить("HTTPСервис");
	мОбъектыСМодулями.Добавить("Константа");
	мОбъектыСМодулями.Добавить("Справочник");
	мОбъектыСМодулями.Добавить("Документ");
	мОбъектыСМодулями.Добавить("ЖурналДокументов");
	мОбъектыСМодулями.Добавить("Перечисление");
	мОбъектыСМодулями.Добавить("Отчет");
	мОбъектыСМодулями.Добавить("Обработка");
	мОбъектыСМодулями.Добавить("ПланВидовХарактеристик");
	мОбъектыСМодулями.Добавить("РегистрСведений");
	мОбъектыСМодулями.Добавить("РегистрНакопления");
	мОбъектыСМодулями.Добавить("БизнесПроцесс");
	мОбъектыСМодулями.Добавить("Задача");
	
	Если СтрЧислоВхождений(стр_список.Название, ".") = 1
		И ЭтоОбъектСМодулями(мОбъектыСМодулями, стр_список.Название) Тогда 
		
		Если СтрЧислоВхождений(стр_список.Название, "Перечисление") = 0 Тогда
			стр_доп = список.Добавить();
			стр_доп.Название = стр_список.Название + ".МодульОбъекта"; 
		КонецЕсли;
		
		Если СтрЧислоВхождений(стр_список.Название, "WebСервис") = 0 
			И СтрЧислоВхождений(стр_список.Название, "HTTPСервис") = 0 Тогда
			стр_доп = список.Добавить();
			стр_доп.Название = стр_список.Название + ".МодульМенеджера"; 
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры        

&НаКлиенте
Функция ЭтоОбъектСМодулями(мОбъектыСМодулями, стр_) 
	
	Для каждого общ_ Из мОбъектыСМодулями Цикл
		Если СтрЧислоВхождений(стр_, общ_) = 1 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;    
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ВыбратьПоФильтру(Команда)
	ВыбратьПоФильтруАсинх();
КонецПроцедуры  

&НаКлиенте
Асинх Процедура ВыбратьПоФильтруАсинх()
		
	фильтр_ = "";  
	об_ = ВвестиСтрокуАсинх(фильтр_, "Фильтр");
	фильтр_ = Ждать об_; 
	
	Если об_ = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	Для каждого стр_ Из список Цикл
		Если СтрЧислоВхождений(стр_.Название, фильтр_) > 0 Тогда
			стр_.ВыбФлаг = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры



&НаСервере
Процедура ОбработатьСписокНаСервере() 
	
	табл = список.Выгрузить(); 
	табл.Свернуть("Название"); 
	список.Загрузить(табл);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОбъектыИзменений.Ссылка КАК Ссылка,
	|	ОбъектыИзменений.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ОбъектыИзменений КАК ОбъектыИзменений
	|ГДЕ
	|	ОбъектыИзменений.Владелец = &Владелец
	|	И ОбъектыИзменений.Наименование В(&Наименование)";
	Запрос.УстановитьПараметр("Владелец", Конфигурация);
	Запрос.УстановитьПараметр("Наименование", табл.ВыгрузитьКолонку("Название"));
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	соотв = Новый Соответствие;
	Пока РезультатЗапроса.Следующий() Цикл
		соотв.Вставить(РезультатЗапроса.Наименование, РезультатЗапроса.Ссылка);	
	КонецЦикла;      
	
	табл = список.Выгрузить(); 
	Для каждого стр_ Из табл Цикл
		стр_.Справочник = соотв.Получить(стр_.Название); 
		стр_.УжеЕсть = СущОбъекты.Получить(стр_.Справочник) <> Неопределено;
	КонецЦикла;
	
	список.Загрузить(табл);
	
КонецПроцедуры










