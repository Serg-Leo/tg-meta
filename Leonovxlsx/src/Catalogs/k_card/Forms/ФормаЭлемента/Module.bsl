
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ТекущийЭлемент = Элементы.СсылкаНаЗадачу;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьИнфоОЗадаче(Команда)
	ответ_ = ОбщийМодульКлиентСервер.ЗадачаПолучитьИнфо(Объект.Код);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоСсылке(Команда)
	
	Объект.СсылкаНаЗадачу = СокрЛП(Объект.СсылкаНаЗадачу);
	Если ПустаяСтрока(Объект.СсылкаНаЗадачу) Тогда
		Возврат;	
	КонецЕсли;  
	
	поз = СтрНайти(Объект.СсылкаНаЗадачу, "?");
	Если поз > 0 Тогда
		Объект.СсылкаНаЗадачу = Лев(Объект.СсылкаНаЗадачу, поз - 1);
	КонецЕсли;
	массив = СтрРазделить(Объект.СсылкаНаЗадачу, "/", Ложь);   
	Объект.Код = массив[массив.ВГраница()];
	Объект.СсылкаНаЗадачу = "https://togas.kaiten.ru/" + Объект.Код;
	
	ответ_ = ОбщийМодульКлиентСервер.ЗадачаПолучитьИнфо(Объект.Код);
	ОбработатьДанныеЗадачиНаСервере(ответ_);
	
КонецПроцедуры   

&НаСервере
Процедура ОбработатьДанныеЗадачиНаСервере(ответ_)
	
	массив = Новый Массив;
	массив.Добавить(ответ_);
	Контекст = ОбщийМодульСервер.ОбработатьДанныеЗадач(массив);  
	ОбщийМодульСервер.ЗаполнитьЗадачуСпр(Объект, ответ_, Контекст);  
	 
КонецПроцедуры


&НаКлиенте
Процедура СсылкаНаЗадачуПриИзменении(Элемент)
	
	Если Объект.Ссылка.Пустая() Тогда
		ЗаполнитьПоСсылке(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

