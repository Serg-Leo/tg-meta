
Процедура УстановкаПараметровСеанса(ТребуемыеПараметры) 
	
	массив = СтрРазделить(ПользователиИнформационнойБазы.ТекущийПользователь().АдресЭлектроннойПочты, "@", Ложь); 
	Если ЗначениеЗаполнено(массив) Тогда
		ПараметрыСеанса.ApiKey = массив[0];
	КонецЕсли;  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Разработчики.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Разработчики КАК Разработчики
	|ГДЕ
	|	Разработчики.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Наименование", ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		ПараметрыСеанса.ТекущийРазработчик = РезультатЗапроса.Ссылка;
	КонецЕсли;
	
КонецПроцедуры
