
Функция СтруктураИзВыборкиЗапроса(Выборка) Экспорт
	
	Результат = Новый Структура;
	Для каждого Колонка Из Выборка.Владелец().Колонки Цикл
		Результат.Вставить(Колонка.Имя);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(Результат,Выборка);
	//Результат.Вставить("ИсходнаяВыборка", Выборка);
	
	Возврат Результат;
	
КонецФункции
						   
Функция ПреобразоватьJSONВСтруктуру(данные_, ИменаСвойствСоЗначениямиДата = Неопределено) Экспорт
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(данные_);
	Возврат ПрочитатьJSON(ЧтениеJSON, Ложь, ИменаСвойствСоЗначениямиДата);
КонецФункции

Функция ПреобразоватьСтруктуруВJSON(структура_) Экспорт
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(ЗаписьJSON, структура_); Возврат ЗаписьJSON.Закрыть();	
КонецФункции       

Функция УдалитьНепечатныеСимволыИзСтроки(строка_) Экспорт
	
	Возврат СтрЗаменить(строка_, Символ(29), ""); //пока нужно только символ GS удалять
		
КонецФункции


Функция ПрочитатьДвоичныеДанныеКартинки(Знач СтрокаBase64)
	
	Если ЗначениеЗаполнено(СтрокаBase64) Тогда
		СтрокаBase64 = СтрЗаменить(СтрокаBase64, "data:image/png;base64,", "");
		СтрокаBase64 = СтрЗаменить(СтрокаBase64, "data:image/jpeg;base64,", "");
	Иначе
		СтрокаBase64 = "";
	КонецЕсли;
	
	Возврат Base64Значение(СтрокаBase64);
	
КонецФункции


Функция УстановитьСоединение_kaiten(Таймаут = 30)
	
	Возврат Новый HTTPСоединение("togas.kaiten.ru",,,,, Таймаут, Новый ЗащищенноеСоединениеOpenSSL());
	
КонецФункции

Функция ВыполнитьЗапрос_kaiten(Соединение = Неопределено, данныеЗапроса_ = "", запрос_, метод_ = "GET", Таймаут = 30)
	
	Если Соединение = Неопределено Тогда
		Соединение = УстановитьСоединение_kaiten(Таймаут);
	КонецЕсли; 

	Запрос = Новый HTTPЗапрос("/api/latest/" + запрос_);
	Запрос.Заголовки.Вставить("Authorization", "Bearer " + ОбщийМодульПовтИсп.ПолучитьBearerApiKey());

	стрОтвета = Новый Структура("Ответ,Тело,ИнформацияОбОшибке");  
	
	Попытка
		Если ВРег(метод_) = "POST" Тогда 
			
			Запрос.Заголовки.Вставить("Content-Type", "application/json"); 
			Запрос.УстановитьТелоИзСтроки(данныеЗапроса_);
			Ответ = Соединение.ОтправитьДляОбработки(Запрос); 
			
		ИначеЕсли ВРег(метод_) = "PUT" Тогда     
			
			ЗаполнитьЗапросДляПомещенияФайла(Запрос, данныеЗапроса_);
			Ответ = Соединение.Записать(Запрос);  
			
		ИначеЕсли ВРег(метод_) = "PATCH" Тогда 
			
			Запрос.Заголовки.Вставить("Content-Type", "application/json"); 
			Запрос.УстановитьТелоИзСтроки(данныеЗапроса_);
			Ответ = Соединение.Изменить(Запрос);
			
		ИначеЕсли ВРег(метод_) = "DELETE" Тогда
			Ответ = Соединение.Удалить(Запрос); 
		Иначе //GET	
			Ответ = Соединение.Получить(Запрос); 
		КонецЕсли; 
		стрОтвета.Ответ = Ответ;
		стрОтвета.Тело  = Ответ.ПолучитьТелоКакСтроку("UTF-8");
	Исключение
		//стрОтвета.ИнформацияОбОшибке = ИнформацияОбОшибке().Причина.Описание;
		стрОтвета.ИнформацияОбОшибке = ОписаниеОшибки();
		стрОтвета.Ответ = Новый Структура("Ответ", Новый Структура("КодСостояния", 500));
	КонецПопытки;   
	
	//ОбщийМодульСервер.ОбработатьЗаголовкиОтветаАПИ(Ответ.Заголовки);
	
	Возврат стрОтвета; 
	
КонецФункции    

Функция ПреобразоватьJSONВСтруктуруСДатами(данныеJSON) 
	
	Попытка
		стрПарам = ПреобразоватьJSONВСтруктуру(данныеJSON, "created,updated"); //notification_sent
	Исключение
	    Возврат ОписаниеОшибки();
	КонецПопытки;
	
	Возврат стрПарам;  
	
КонецФункции

Функция ЗадачаПолучитьИнфо(НомерЗадачи) Экспорт
	
	ответ_ = ВыполнитьЗапрос_kaiten(,, "cards/" + СокрЛП(НомерЗадачи),, 5); 
	Если НЕ ПустаяСтрока(ответ_.ИнформацияОбОшибке) ИЛИ ответ_.Ответ.КодСостояния <> 200 Тогда
		Возврат ответ_;
	КонецЕсли;
	Возврат ПреобразоватьJSONВСтруктуруСДатами(ответ_.Тело);
		
КонецФункции  

Функция ЗаполнитьЗапросДляПомещенияФайла(Запрос, данныеЗапроса_)
	
	//файл_ = Новый Файл(ДанныеФайла.ИмяФайлаСДанными);   
	
	Разделитель = СтрЗаменить(Новый УникальныйИдентификатор, "-", "");
	РазделительСтрок = Символы.ВК + Символы.ПС;
	
	ТелоЗапроса = Запрос.ПолучитьТелоКакПоток();
	ЗаписьДанных = Новый ЗаписьДанных(ТелоЗапроса, КодировкаТекста.UTF8, ПорядокБайтов.LittleEndian, "", "", Ложь);
	
	ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель + РазделительСтрок);
	ЗаписьДанных.ЗаписатьСтроку("Content-Disposition: form-data; name=""file""; filename=""" + данныеЗапроса_.ИмяФайла + """");
	ЗаписьДанных.ЗаписатьСтроку(РазделительСтрок);
	//ЗаписьДанных.ЗаписатьСтроку("Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
	ЗаписьДанных.ЗаписатьСтроку("Content-Type: application/vnd.ms-excel");
	ЗаписьДанных.ЗаписатьСтроку(РазделительСтрок);
	ЗаписьДанных.ЗаписатьСтроку(РазделительСтрок);
	ЗаписьДанных.Записать(Новый ДвоичныеДанные(данныеЗапроса_.ИмяФайлаСДанными));
	ЗаписьДанных.ЗаписатьСтроку(РазделительСтрок);     
	
	Если данныеЗапроса_.ВСоставеКомментария Тогда   
		
		ГУИД_файла = Строка(Новый УникальныйИдентификатор);
		данныеЗапроса_.Вставить("ГУИД_файла", ГУИД_файла);
		
		ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель + РазделительСтрок);
		ЗаписьДанных.ЗаписатьСтроку("Content-Disposition: form-data; name=""save""");
		ЗаписьДанных.ЗаписатьСтроку(РазделительСтрок);
		ЗаписьДанных.ЗаписатьСтроку(РазделительСтрок);
		ЗаписьДанных.ЗаписатьСтроку("false");
		ЗаписьДанных.ЗаписатьСтроку(РазделительСтрок);  
		
		ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель + РазделительСтрок);
		ЗаписьДанных.ЗаписатьСтроку("Content-Disposition: form-data; name=""uid""");
		ЗаписьДанных.ЗаписатьСтроку(РазделительСтрок);
		ЗаписьДанных.ЗаписатьСтроку(РазделительСтрок);
		ЗаписьДанных.ЗаписатьСтроку(ГУИД_файла);
		ЗаписьДанных.ЗаписатьСтроку(РазделительСтрок);  
		
	КонецЕсли;
	
	ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель + "--" + РазделительСтрок);
	ЗаписьДанных.Закрыть();
	
	Запрос.Заголовки.Вставить("Content-Type", СтрШаблон("multipart/form-data; boundary=%1", Разделитель)); 
	
КонецФункции

Функция ЗадачаДобавитьФайл(НомерЗадачи, ДанныеФайла) Экспорт
	
	#Область пример_КоннекторHTTP
	//Файлы = Новый Структура;
	//Файлы.Вставить("Имя", "f1");
	//Файлы.Вставить("ИмяФайла", "file1.txt");
	//Файлы.Вставить("Данные", Base64Значение("0J/RgNC40LLQtdGCINCc0LjRgCE="));
	//Файлы.Вставить("Тип", "text/plain");

	//Результат = КоннекторHTTP.Post("https://httpbin.org/post", Неопределено, Новый Структура("Файлы", Файлы));  
	//Возврат Неопределено;
	#КонецОбласти
	
    Если НЕ ДанныеФайла.Свойство("ВСоставеКомментария") Тогда
		ДанныеФайла.Вставить("ВСоставеКомментария", Ложь);
	КонецЕсли;
	
	ответ_ = ВыполнитьЗапрос_kaiten(, ДанныеФайла, "cards/" + СокрЛП(НомерЗадачи) + "/files", "PUT");
	Если НЕ ответ_.Ответ.КодСостояния = 200 Тогда
		Возврат ответ_.Тело;
	КонецЕсли;
	Попытка
		стрПарам = ПреобразоватьJSONВСтруктуру(ответ_.Тело, "created,updated"); 
	Исключение
	    Возврат Новый Структура("ОписаниеОшибки", ОписаниеОшибки());
	КонецПопытки; 
	
	Если НЕ ДанныеФайла.ВСоставеКомментария Тогда
		Возврат стрПарам;
	КонецЕсли;       
	
	Возврат ЗадачаДобавитьКомментарий(НомерЗадачи, ДанныеФайла, стрПарам);
		
КонецФункции 

Функция ЗадачаДобавитьКомментарий(НомерЗадачи, ДанныеКомментария, стрФайла = Неопределено) Экспорт
	
	стрЗапроса = Новый Структура("text,attachments", ДанныеКомментария.Комментарий, Новый Массив);   
	
	Если ТипЗнч(стрФайла) = Тип("Структура") Тогда
		
		Если стрФайла.Свойство("author_id") Тогда
			стрЗапроса.Вставить("author_id", стрФайла.author_id);
		КонецЕсли;                        

		стрПарам = Новый Структура("card_id,url,name,created,size,uid");
		ЗаполнитьЗначенияСвойств(стрПарам, стрФайла);
		//стрПарам.Вставить("uid", ДанныеКомментария.ГУИД_файла);
		стрПарам.Вставить("comment_id", Неопределено);
		стрПарам.Вставить("type", 1); //8
		стрПарам.Вставить("unsaved", Истина);
		стрПарам.Вставить("percent", 100);
		стрЗапроса.attachments.Добавить(стрПарам); 
		
	КонецЕсли;
	
	ответ_ = ВыполнитьЗапрос_kaiten(, ПреобразоватьСтруктуруВJSON(стрЗапроса), "cards/" + СокрЛП(НомерЗадачи) + "/comments", "POST");
	Возврат ПреобразоватьJSONВСтруктуруСДатами(ответ_.Тело);

КонецФункции

