	ответ_ = ВыполнитьЗапрос_kaiten(,, "cards" + ?(ЗначениеЗаполнено(offset), "?offset=" + Формат(offset, "ЧГ=0"), ""));
	Попытка
		//стрПарам = ПреобразоватьJSONВСтруктуру(ответ_.Тело, "created,updated,last_moved_at,lane_changed_at,column_changed_at,first_moved_to_in_progress_at,comment_last_added_at,counters_recalculated_at");
		стрПарам = ПреобразоватьJSONВСтруктуру(ответ_.Тело, "created,updated");
	Исключение
	    Возврат ОписаниеОшибки();
	КонецПопытки;
	
	Возврат стрПарам;
		
КонецФункции      

Процедура ЗагрузитьОбновитьЗадачи() Экспорт
	
	ОбщийМодульСервер.ОбработатьЗагрузкуЗадач();   
	Возврат;
	Для ном = 10 По 50 Цикл
		
		мЗадачи = ЗадачиПолучить_card_list(ном * 100);
		Если НЕ ЗначениеЗаполнено(мЗадачи) Тогда
			Прервать;
		КонецЕсли;
		ОбщийМодульСервер.ОбработатьЗагрузкуЗадач(мЗадачи); 
		
	КонецЦикла;
	
КонецПроцедуры





