
Функция ПолучитьBearerApiKey() Экспорт

	Возврат ПараметрыСеанса.ApiKey;
	
КонецФункции

Процедура ОбработатьЗаголовкиОтветаАПИ(знач Заголовки) Экспорт
	
	//"X-RateLimit-Limit"
	//"X-RateLimit-Reset"
	//"X-RateLimit-Remaining"

	дата_ =  МестноеВремя('19700101' + Заголовки["X-RateLimit-Reset"]);
	время_ = дата_ - ТекущаяУниверсальнаяДата();
	
КонецПроцедуры

Процедура ЗаписатьДанныеЗадач(мЗадачи) Экспорт

	Для каждого задача Из мЗадачи Цикл
		
		рег_ = РегистрыСведений.ДанныеЗадач.СоздатьМенеджерЗаписи();
		рег_.ДатаПолучения = ТекущаяДата();  
		рег_.КодЗадачи = Формат(задача.id, "ЧГ=0");
		рег_.ДанныеВСтруктуре = Новый ХранилищеЗначения(задача, Новый СжатиеДанных(9));
		рег_.Записать();
		
	КонецЦикла;
	
КонецПроцедуры  

Функция ПрочитатьДанныеЗадач() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеЗадач.ДанныеВСтруктуре КАК ДанныеВСтруктуре
	|ИЗ
	|	РегистрСведений.ДанныеЗадач КАК ДанныеЗадач";
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	мЗадачи = Новый Массив;
	Пока РезультатЗапроса.Следующий() Цикл
		мЗадачи.Добавить(РезультатЗапроса.ДанныеВСтруктуре.Получить());
	КонецЦикла;  
	
	Возврат мЗадачи;
	
КонецФункции


Функция СоздатьКонтекстЗагрузкиЗадач()
	
	стрПарам = Новый Структура;  
	стрПарам.Вставить("data", Новый Соответствие); 
	стрПарам.Вставить("k_card", Новый Массив); 
	стрПарам.Вставить("space", Новый Массив); 
	стрПарам.Вставить("board", Новый Массив); 
	стрПарам.Вставить("column", Новый Массив); 
	стрПарам.Вставить("lane", Новый Массив); 
	стрПарам.Вставить("type", Новый Массив); 
	стрПарам.Вставить("owner", Новый Массив);
	стрПарам.Вставить("tag", Новый Массив); 
	
	стрПарам.Вставить("ИменаРеквизитов", Новый Массив);
	стрПарам.ИменаРеквизитов.Добавить("board");
	стрПарам.ИменаРеквизитов.Добавить("column");
	стрПарам.ИменаРеквизитов.Добавить("lane");
	стрПарам.ИменаРеквизитов.Добавить("type");
	стрПарам.ИменаРеквизитов.Добавить("owner"); 
	
	Возврат стрПарам;
	
КонецФункции

Процедура ОбработатьЗагрузкуЗадач(мЗадачи = Неопределено) Экспорт
	
	Если мЗадачи = Неопределено Тогда 
		мЗадачи = ПрочитатьДанныеЗадач();
	Иначе	
		ЗаписатьДанныеЗадач(мЗадачи);
	КонецЕсли;    
	
	Контекст = ОбработатьДанныеЗадач(мЗадачи);
	Для каждого ДанныеЗадачи Из мЗадачи Цикл
		ОбработатьДанныеЗадачи(ДанныеЗадачи, Контекст);
	КонецЦикла; 
			
КонецПроцедуры

Функция ОбработатьДанныеЗадач(мЗадачи) Экспорт
	
	Контекст = СоздатьКонтекстЗагрузкиЗадач();
	
	Для каждого ДанныеЗадачи Из мЗадачи Цикл
		ОбработатьДанныеЗадачи(ДанныеЗадачи, Контекст);
	КонецЦикла; 
	
	ВыполнитьЗапросПоДаннымЗадачи(Контекст); 
	
	массив = Новый Массив;
	Для каждого кл_знч Из Контекст.data Цикл   
		нСтрока = Контекст.РезультатЗапроса.Найти(кл_знч.Ключ, "Имя");
		Если нСтрока = Неопределено Тогда
			массив.Добавить(кл_знч.Ключ);
			Продолжить;
		КонецЕсли;                          
		кл_знч.Значение.Вставить("Ссылка", нСтрока.Ссылка);
	КонецЦикла; 
	Контекст.Вставить("Создать", массив);
		
	СоздатьНедостающиеСправочники(Контекст); 
	Возврат Контекст;
	
КонецФункции    

Процедура ЗаполнитьЗадачуСпр(СпрОбъект, ДанныеЗадачи, Контекст) Экспорт  
	
	СпрОбъект.Код = Формат(ДанныеЗадачи.id, "ЧГ=0");
	СпрОбъект.Наименование = ДанныеЗадачи.title;
	СпрОбъект.ПолноеНаименование = ДанныеЗадачи.title;
	
	Для каждого имя_ Из Контекст.ИменаРеквизитов Цикл
		Если ДанныеЗадачи.Свойство(имя_) Тогда   
			ДобавитьДанныеВЗадачу(СпрОбъект, имя_, Контекст, имя_ + "_" + ДанныеЗадачи[имя_].id);
		КонецЕсли;
	КонецЦикла;

	Если ДанныеЗадачи.Свойство("members") Тогда
		
		СпрОбъект.members.Очистить();
		Для каждого стр_ Из ДанныеЗадачи.members Цикл
			ДобавитьДанныеВЗадачу(СпрОбъект.members.Добавить(), "user", Контекст, "owner_" + стр_.id);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры   

Процедура ДобавитьДанныеВЗадачу(СпрОбъект, имя_, Контекст, ДанныеЗадачи_id)
	
	нЗначение = Контекст.data.Получить(ДанныеЗадачи_id); 
	Если нЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;                        
	Если имя_ = "owner" Тогда
		имя_ = "k_owner";
	КонецЕсли;
	СпрОбъект[имя_] = нЗначение.Ссылка;
	
КонецПроцедуры


Процедура СоздатьНедостающиеСправочники(Контекст) 
	
	Для каждого эл_ Из Контекст.Создать Цикл  
		СоздатьЭлементСправочника(эл_, Контекст.data[эл_]);
	КонецЦикла;
		
КонецПроцедуры  

Процедура СоздатьЭлементСправочника(имя, данныеСпр)
	
	имяСправочника = "";
	Если СтрНачинаетсяС(имя, "owner") Тогда
		имяСправочника = "k_user";
	ИначеЕсли СтрНачинаетсяС(имя, "column") Тогда
		имяСправочника = "k_column";
	ИначеЕсли СтрНачинаетсяС(имя, "board") Тогда
		имяСправочника = "k_board";
	ИначеЕсли СтрНачинаетсяС(имя, "space") Тогда
		имяСправочника = "k_space";
	ИначеЕсли СтрНачинаетсяС(имя, "lane") Тогда
		имяСправочника = "k_lane";
	ИначеЕсли СтрНачинаетсяС(имя, "type") Тогда
		имяСправочника = "k_type";
	ИначеЕсли СтрНачинаетсяС(имя, "tag") Тогда
		имяСправочника = "k_tag";
	Иначе
		Возврат;
	КонецЕсли; 
	
	спр_объект = Справочники[имяСправочника].СоздатьЭлемент();
	ЗаполнитьЗначенияСвойств(спр_объект, данныеСпр);
	
	Если данныеСпр.Свойство("uid") Тогда
		спр_объект.УстановитьСсылкуНового(Справочники[имяСправочника].ПолучитьСсылку(Новый УникальныйИдентификатор(данныеСпр.uid)));
	КонецЕсли;
	
	спр_объект.Записать(); 
	данныеСпр.Вставить("Ссылка", спр_объект.Ссылка);
	
КонецПроцедуры



Процедура ОбработатьДанныеЗадачи(ДанныеЗадачи, Контекст) Экспорт
	
	Для каждого имя_ Из Контекст.ИменаРеквизитов Цикл
		ДобавитьДанныеВКонтекст(имя_, Контекст, ДанныеЗадачи);
	КонецЦикла;

	Если ДанныеЗадачи.Свойство("members") Тогда
		
		Для каждого стр_ Из ДанныеЗадачи.members Цикл
			ДобавитьДанныеВКонтекст("owner", Контекст, Новый Структура("owner", стр_));
		КонецЦикла;
		
	КонецЕсли;
	//XMLЗначение(Тип("Дата"), ДанныеЗадачи.comment_last_added_at);
		
КонецПроцедуры     

Процедура ДобавитьДанныеВКонтекст(имя, Контекст, ДанныеЗадачи) 
	
	Если НЕ ДанныеЗадачи.Свойство(имя) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗадачи[имя].id) = Тип("Число") Тогда
		ДанныеЗадачи[имя].id = Формат(ДанныеЗадачи[имя].id, "ЧГ=0");
	КонецЕсли;    
	ДобавитьВМассивЗначение(Контекст[имя], ДанныеЗадачи[имя].id); 
	
	структура_ = Новый Структура("Код", ДанныеЗадачи[имя].id);
	ДобавитьДанныеВСтруктуру(структура_, ДанныеЗадачи, имя, "uid");
	ДобавитьДанныеВСтруктуру(структура_, ДанныеЗадачи, имя, "title", "Наименование");
	ДобавитьДанныеВСтруктуру(структура_, ДанныеЗадачи, имя, "full_name", "Наименование");
	ДобавитьДанныеВСтруктуру(структура_, ДанныеЗадачи, имя, "name", "Наименование");
	ДобавитьДанныеВСтруктуру(структура_, ДанныеЗадачи, имя, "type");
	ДобавитьДанныеВСтруктуру(структура_, ДанныеЗадачи, имя, "letter");
	ДобавитьДанныеВСтруктуру(структура_, ДанныеЗадачи, имя, "email");
	ДобавитьДанныеВСтруктуру(структура_, ДанныеЗадачи, имя, "username");
	ДобавитьДанныеВСтруктуру(структура_, ДанныеЗадачи, имя, "initials"); 
	Контекст.data.Вставить(имя + "_" + ДанныеЗадачи[имя].id, структура_);
	
КонецПроцедуры   

Процедура ДобавитьДанныеВСтруктуру(структура_, ДанныеЗадачи, имя, имяСвойства, имяВСтруктуре = Неопределено) 
	
	Если имяВСтруктуре = Неопределено Тогда
		 имяВСтруктуре = имяСвойства;
	 КонецЕсли;
	 
	Если ДанныеЗадачи[имя].Свойство(имяСвойства) Тогда
		структура_.Вставить(имяВСтруктуре, ДанныеЗадачи[имя][имяСвойства]);
	КонецЕсли; 
	
КонецПроцедуры


Процедура ДобавитьВМассивЗначение(массив, значение)  
	
	Если массив.Найти(значение) = Неопределено Тогда 
		массив.Добавить(значение);
	КонецЕсли;	
	
КонецПроцедуры

Процедура ВыполнитьЗапросПоДаннымЗадачи(стрПарам)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	k_user.Ссылка КАК Ссылка,
	|	k_user.Код КАК Код,
	|	""owner_"" + k_user.Код КАК Имя
	|ИЗ
	|	Справочник.k_user КАК k_user
	|ГДЕ
	|	k_user.Код В(&owner)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	k_column.Ссылка,
	|	k_column.Код,
	|	""column_"" + k_column.Код
	|ИЗ
	|	Справочник.k_column КАК k_column
	|ГДЕ
	|	k_column.Код В(&column)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	k_board.Ссылка,
	|	k_board.Код,
	|	""board_"" + k_board.Код
	|ИЗ
	|	Справочник.k_board КАК k_board
	|ГДЕ
	|	k_board.Код В(&board)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	k_space.Ссылка,
	|	k_space.Код,
	|	""space_"" + k_space.Код
	|ИЗ
	|	Справочник.k_space КАК k_space
	|ГДЕ
	|	k_space.Код В(&space)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	k_lane.Ссылка,
	|	k_lane.Код,
	|	""lane_"" + k_lane.Код
	|ИЗ
	|	Справочник.k_lane КАК k_lane
	|ГДЕ
	|	k_lane.Код В(&lane)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	k_type.Ссылка,
	|	k_type.Код,
	|	""type_"" + k_type.Код
	|ИЗ
	|	Справочник.k_type КАК k_type
	|ГДЕ
	|	k_type.Код В(&type)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	k_tag.Ссылка,
	|	k_tag.Код,
	|	""tag_"" + k_tag.Код
	|ИЗ
	|	Справочник.k_tag КАК k_tag
	|ГДЕ
	|	k_tag.Код В(&tag)"; 
	
	Запрос.УстановитьПараметр("space", стрПарам.space);
	Запрос.УстановитьПараметр("board", стрПарам.board);
	Запрос.УстановитьПараметр("column", стрПарам.column);
	Запрос.УстановитьПараметр("lane", стрПарам.lane);
	Запрос.УстановитьПараметр("type", стрПарам.type);
	Запрос.УстановитьПараметр("owner", стрПарам.owner);
	Запрос.УстановитьПараметр("tag", стрПарам.tag);
	
	стрПарам.Вставить("РезультатЗапроса", Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры


