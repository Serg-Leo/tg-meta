
Процедура ДобавитьЗапись(СтрокаJSON, HTTPМетод = "") Экспорт
	
	стрПарам = Новый Структура("ДатаВремя,УникальныйИдентификатор", ТекущаяУниверсальнаяДата(), Новый УникальныйИдентификатор);
	
	НаборЗаписей = РегистрыСведений.WebHooks.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ДатаВремя.Установить(стрПарам.ДатаВремя);
	НаборЗаписей.Отбор.УникальныйИдентификатор.Установить(стрПарам.УникальныйИдентификатор);
	
	МенеджерЗаписи = НаборЗаписей.Добавить();
    ЗаполнитьЗначенияСвойств(МенеджерЗаписи, стрПарам);
	МенеджерЗаписи.СтрокаJSON = СтрокаJSON;  
	МенеджерЗаписи.Метод = HTTPМетод;  
	
	НаборЗаписей.ОбменДанными.Загрузка = Истина;
	НаборЗаписей.Записать();
	
КонецПроцедуры
