
//@skip-check bsl-legacy-check-if-preprocessor-part-environments
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	список_ = ПолучитьСписокИзменений(ПараметрКоманды);
	
#Если Клиент И Сервер Тогда
	список_ = Новый СписокЗначений;
#КонецЕсли  

	ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьОбработкуКоманды", ЭтотОбъект);

	Если список_.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Нет выполненных изменений", 2);
		Возврат;
	ИначеЕсли список_.Количество() = 1 Тогда
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, список_[0]);
		Возврат;
	КонецЕсли;   
	
	список_.ПоказатьВыборЭлемента(ОписаниеОповещения, "Выполненные изменения");
	
КонецПроцедуры  

&НаКлиенте
Процедура ПродолжитьОбработкуКоманды(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ПоказатьЗначение(, ВыбранныйЭлемент.Значение);
	
КонецПроцедуры


&НаСервере
Функция ПолучитьСписокИзменений(Задача_)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВыполненноеИзменение.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВыполненноеИзменение КАК ВыполненноеИзменение
	|ГДЕ
	|	ВыполненноеИзменение.Задача = &Задача
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВыполненноеИзменение.МоментВремени";
	Запрос.УстановитьПараметр("Задача", Задача_);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	список_ = Новый СписокЗначений;   
	Пока РезультатЗапроса.Следующий() Цикл
		список_.Добавить(РезультатЗапроса.Ссылка);	
	КонецЦикла;
	
	Возврат список_;
	
КонецФункции

