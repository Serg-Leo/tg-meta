
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Задача_ = Неопределено;
	Параметры.Свойство("ПараметрКоманды", Задача_);  
	
	Если НЕ ЗначениеЗаполнено(Задача_) Тогда
		 Отказ = Истина;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	k_card.Ссылка КАК Задача,
	|	k_card.Код КАК КодЗадачи,
	|	k_card.СсылкаНаЗадачу КАК СсылкаНаЗадачу,
	|	k_card.Наименование КАК ЗадачаНаименование
	|ИЗ
	|	Справочник.k_card КАК k_card
	|ГДЕ
	|	k_card.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВыполненноеИзменение.Задача,
	|	ВыполненноеИзменение.Задача.Код,
	|	ВыполненноеИзменение.Задача.СсылкаНаЗадачу,
	|	ВыполненноеИзменение.Задача.Наименование
	|ИЗ
	|	Документ.ВыполненноеИзменение КАК ВыполненноеИзменение
	|ГДЕ
	|	ВыполненноеИзменение.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Задача_);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда 
		ЗаполнитьЗначенияСвойств(ЭтаФорма, РезультатЗапроса);
		//Элементы.ФормаОткрытьЗадачуПоСсылке.Заголовок = "#" + КодЗадачи + " " + ЗадачаНаименование;
	КонецЕсли;    
	
	Разработчик = ПараметрыСеанса.ТекущийРазработчик;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьОтображениеЭлементов();
	ПрочитатьДанныеЗадачи();
	ПрочитатьКомментарииЗадачи();
	
КонецПроцедуры  

&НаКлиенте
Процедура ПрочитатьДанныеЗадачи()

	ответ_ = ОбщийМодульКлиентСервер.ЗадачаПолучитьИнфо(КодЗадачи); 
	СтатусСтрокой = ответ_.column.title;
	column_id = ответ_.column.id;
	board_id = ответ_.board.id;
	
	Если ответ_.column.Свойство("parent") Тогда
		СтатусСтрокой = ответ_.column.parent.title + " / " + СтатусСтрокой;
	КонецЕсли;
	
	Для каждого файл Из ответ_.files Цикл
		Если СтрЧислоВхождений(файл.name, КодЗадачи) > 0 Тогда
			file_id = файл.id;
		КонецЕсли;
	КонецЦикла;  
	
	Если ЗначениеЗаполнено(file_id) Тогда
		Элементы.ФормаДобавитьФайлВЗадачу.Заголовок = "Заменить файл в задаче"
	КонецЕсли;   
	
	ответ_ = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьКомментарииЗадачи()

	ответ_ = ОбщийМодульКлиентСервер.ЗадачаПолучить_comments(КодЗадачи); 
	
	Для каждого комментарий_ Из ответ_ Цикл 
		
		Если НЕ ЗначениеЗаполнено(комментарий_.text) Тогда
			Продолжить;
		КонецЕсли; 
		
		стр_КомментарииСписок = КомментарииСписок.Добавить();
		стр_КомментарииСписок.created = комментарий_.created;
		стр_КомментарииСписок.Комментарий = ОбщийМодульКлиентСервер.УдалитьНепечатныеСимволыИзСтроки(комментарий_.text);
		стр_КомментарииСписок.Автор = комментарий_.author.full_name;
		
	КонецЦикла; 
	
	КомментарииСписок.Сортировать("created убыв");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеЭлементов()

	Элементы.Комментарий.Доступность = ВыбКоммент = 2;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбКомментПриИзменении(Элемент) 
	
	ОбновитьОтображениеЭлементов();
	
КонецПроцедуры

