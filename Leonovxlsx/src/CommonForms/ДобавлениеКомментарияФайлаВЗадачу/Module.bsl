&НаКлиенте
Процедура ДобавитьКомментарийВЗадачу(Команда) 
	
	стрПарам = Новый Структура;
	стрПарам.Вставить("Задача", Задача);
	стрПарам.Вставить("Комментарий", "");
	стрПарам.Вставить("ЗадачаНомер", КодЗадачи);
	стрПарам.Вставить("ВСоставеКомментария", Истина); 
	стрПарам.Вставить("ДобавитьФайл", Ложь); 
	
	Если ВыбКоммент = 0 Тогда
		стрПарам.Комментарий = "Готово, можно проверять";
	ИначеЕсли ВыбКоммент = 1 Тогда
		стрПарам.Комментарий  = "Помещено в хранилище";
		//стрПарам.ДобавитьФайл = Истина; 
	ИначеЕсли ВыбКоммент = 2 Тогда  
		Если НЕ ЗначениеЗаполнено(Комментарий) Тогда
			ПоказатьПредупреждение(, "Не заполнен коммментарий."); 
			Возврат;
		КонецЕсли;
		стрПарам.Комментарий = Комментарий;
	КонецЕсли;
	
	//Если ВыбКоммент = 1 Тогда
	//	ответ_ = ДобавитьФайлКомментарийНаСервере(стрПарам); 
	//	Если ЗначениеЗаполнено(ответ_.attachments) Тогда
	//		file_id = ответ_.attachments[0].id;
	//	КонецЕсли;
	//Иначе	
		ответ_ = ОбщийМодульКлиентСервер.ЗадачаДобавитьКомментарий(стрПарам.ЗадачаНомер, стрПарам);
	//КонецЕсли;
	
	стр_КомментарииСписок = КомментарииСписок.Вставить(0);
	стр_КомментарииСписок.created = ответ_.created;
	стр_КомментарииСписок.Комментарий = ответ_.text;
	стр_КомментарииСписок.Автор = Разработчик;

КонецПроцедуры


&НаКлиенте
Процедура ИзменитьСтатус(Команда)    
	
	Если НЕ ЗначениеЗаполнено(СписокСтатусов) Тогда
		
		ответ_ = ОбщийМодульКлиентСервер.ЗадачаПолучить_columns(board_id);
		Для каждого элемент_ Из ответ_ Цикл  
			Если элемент_.Свойство("subcolumns") Тогда
				Для каждого subcolumn Из элемент_.subcolumns Цикл
					СписокСтатусов.Добавить(subcolumn.id, элемент_.title + " / " + subcolumn.title);
				КонецЦикла;
				Продолжить;
			КонецЕсли;
			СписокСтатусов.Добавить(элемент_.id, элемент_.title);
		КонецЦикла;

	КонецЕсли;
	
	СписокСтатусовВыбор = Новый СписокЗначений;
	Для каждого стр_ Из СписокСтатусов Цикл
		Если column_id <> стр_.Значение Тогда
			СписокСтатусовВыбор.Добавить(стр_.Значение, стр_.Представление);
		КонецЕсли;
	КонецЦикла;
	ОписаниеОповещения = Новый ОписаниеОповещения("ИзменитьСтатусЗавершение", ЭтаФорма);
	ПоказатьВыборИзМеню(ОписаниеОповещения, СписокСтатусовВыбор);
	
КонецПроцедуры   

&НаКлиенте
Процедура ИзменитьСтатусЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	стрПарам = Новый Структура("column_id", ВыбранныйЭлемент.Значение);
	ответ_ = ОбщийМодульКлиентСервер.Задача_Update_card(КодЗадачи, стрПарам);
	column_id = ответ_.column_id;
	СтатусСтрокой = СписокСтатусов.НайтиПоЗначению(column_id).Представление;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчетПоЗадаче(Команда) 
	
	УсловияОтбора = Новый Структура("Задача", Задача);
	ПараметрыФормы = Новый Структура("Отбор, СформироватьПриОткрытии, КлючНазначенияИспользования, ВидимостьКомандВариантовОтчетов",
		УсловияОтбора, Истина, "ОтчетОбИзмененияхПоЗадаче", Ложь);
	
	ОткрытьФорму("Отчет.ИзмененияПоЗадаче.Форма",
		ПараметрыФормы,
		//ПараметрыВыполненияКоманды.Источник,
		//ПараметрыВыполненияКоманды.Уникальность,
		//ПараметрыВыполненияКоманды.Окно,
		//ПараметрыВыполненияКоманды.НавигационнаяСсылка
	);

КонецПроцедуры
