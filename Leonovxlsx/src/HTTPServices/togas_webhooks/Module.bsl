
Функция newhookANY(Запрос)       
	
	КайтенСервер.ОбработатьВебхук(Запрос);
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.УстановитьТелоИзСтроки("OK (webhook) =" + Запрос.HTTPМетод);
	Возврат Ответ;  
	
КонецФункции

